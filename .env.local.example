# Sanity CMS Configuration
# =====================
# To connect to your Sanity Studio, create a new project at https://sanity.io/manage
# Copy these values to .env.local and update with your actual values

# Required: Your Sanity project ID (found in sanity.json or project settings)
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id

# Required: Dataset name (default is "production")
NEXT_PUBLIC_SANITY_DATASET=production

# Required: API version (ISO date format)
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Optional: API token for write access (only needed for preview mode)
# Get this from https://sanity.io/manage#/api/publish
# SANITY_API_TOKEN=your-api-token
